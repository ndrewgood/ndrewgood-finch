# Firebase Admin (voice memos)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Answering machine admin
ANSWERING_MACHINE_PASSWORD=
ANSWERING_MACHINE_SESSION_SECRET=

# Email notify on new voice memo (Resend — free tier is plenty)
# Create a free account and API key: https://resend.com
RESEND_API_KEY=
# Where notifications go. Without a verified domain, Resend only delivers to
# the account owner's email — use that address here.
VOICE_MEMO_NOTIFY_EMAIL=
# Optional: sender address on a domain verified in Resend, e.g. voice@ndrewgood.com.
# Defaults to onboarding@resend.dev when unset.
RESEND_FROM_EMAIL=
