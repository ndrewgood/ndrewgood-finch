# Firebase Admin (voice memos)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Answering machine admin
ANSWERING_MACHINE_PASSWORD=
ANSWERING_MACHINE_SESSION_SECRET=

# SMS notify on new voice memo (Twilio — Firebase has no outbound SMS API)
# Create a free Twilio account: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio phone number in E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=
# Your phone number in E.164, e.g. +15557654321
VOICE_MEMO_NOTIFY_PHONE=
